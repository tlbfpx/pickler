/* Venue list page styles */
.page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background-color: #f2f2f2;
  border-radius: 36rpx;
}

.search-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-btn {
  margin-left: 20rpx;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  color: #4CAF50;
  font-size: 30rpx;
  font-weight: 500;
}

.venue-list {
  padding: 20rpx 24rpx;
}

/* 表格行式场馆列表:无封面图,名称+地址+联系方式 左对齐成列,右侧箭头 */
.venue-row {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.05);
}

.venue-row:active {
  background-color: #f9fafb;
}

.row-main {
  flex: 1;
  overflow: hidden;
  min-width: 0;
}

.row-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-line {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}

.line-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.line-text {
  font-size: 24rpx;
  color: #6b7280;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.row-arrow {
  color: #c0c4cc;
  font-size: 36rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.loading,
.no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
}
